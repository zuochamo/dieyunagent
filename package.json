    "afterPack": "scripts/after-pack-win-icon.cjs",
    "appId": "com.pixeloffice.agent",
    "productName": "叠云 Agent",
    "directories": {
      "output": "dist"
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "executableName": "dieyunagent",
      "signAndEditExecutable": false,
      "extraResources": [
        {
          "from": "build/dieyun-core",
          "to": "dieyun-core",
          "filter": [
            "**/*"
          ]
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "assets/icons/linux",
      "executableName": "dieyunagent",
      "category": "Development",
      "syncDesktopName": true,
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "deb": {
      "artifactName": "dieyunagent_${version}_amd64.${ext}"
    },
    "appImage": {
      "artifactName": "dieyunagent-${version}-x86_64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "guid": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
      "include": "build/installer-progress.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "叠云 Agent",
      "artifactName": "dieyunagent-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "generic",
      "url": "http://192.168.31.62:3099/"
