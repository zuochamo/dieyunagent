src/renderer/dist/
src/renderer/index.bundled.html
.release-private/
/target/
密钥.txt
build/dieyun-core/
build/dieyun-core-linux/
build/.cache/
build/remote-gateway-pack/
build/mcp-bundled/
# 仓库内 .dieyun/ 全是本机运行时数据（索引 / 附件副本 / worktree 缓存 / 终端记录 / 备份），
# 一条目录规则就够，不再逐个文件列（历史上逐条列过，漏一条就会被 `git add -A` 收进来）
.dieyun/
skills/bundled/**/mcp_output/
skills/bundled/**/*.log
updates-published/*
!updates-published/README.md
mobile-app/android/apk-build/
mobile-app/android/manual-build/
mobile-app/android/.gradle/
mobile-app/android/app/build/
mobile-app/android/local.properties

# 手机版发布签名：密钥与口令只存在本地，不进版本库（模板见 signing.properties.example）
mobile-app/android/keys/
mobile-app/android/signing.properties
deploy.local.json
deploy.packaged.json
build/deploy-packaged.json
dieyun-linux-build.local.json
models/**/*.onnx
.env
.env.*
!.env.example
build-warnings.txt

# 本地索引 / MCP / 日志 / 发布产物（不进版本库）
vectors.db
vectors.db-*
*.db-shm
*.db-wal
.playwright-mcp/
.playwright-cli/
logs_llm/
release/
deploy/*.zip

# 本地工具输出 / 集成终端日志 / 临时调试文件 / 生成产物（不进版本库）
/tmp-*
/.tmp-*
_tmp/
/generated-images/
# 其它 AI 工具与调试落在仓库根的本地缓存 / 日志
.workbuddy/
.zcode/
debug.log

# 根目录 dieyun.md 为运行时用户文件（实际位置 ~/.dieyun/dieyun.md），
# 仓库内唯一模板是 assets/dieyun.md，勿在根目录再放一份副本
/dieyun.md
